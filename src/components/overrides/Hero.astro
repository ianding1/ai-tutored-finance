---
// Home page hero: title, tagline and the start button from the page's `hero` frontmatter.
const hero = Astro.locals.starlightRoute.entry.data.hero!;
const action = hero.actions?.[0];
---

<div class="lfwai-hero">
	<div class="lfwai-hero-text">
		<h1 id="_top" data-page-title>{hero.title}</h1>
		{hero.tagline && <p class="lfwai-hero-tagline" set:html={hero.tagline} />}
		{action && (
			<a class="lfwai-hero-start" href={action.link}>{action.text}</a>
		)}
	</div>
</div>
