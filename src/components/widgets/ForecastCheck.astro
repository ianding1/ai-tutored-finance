---
// Figure 3-1 of lesson 6.13: where a realized average yearly return falls in the forecast distribution, by length of
// the record. Forecast: mean 6% a year, volatility 16%, independent years; the average over N years then has standard
// deviation 16%/sqrt(N). Percentile = N((r - 6) sqrt(N) / 16). Adjustable realized return.
// Parameters are registered in course/widgets.yaml (id: forecast-check). Same model as course/verify/6.13.py.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		r: '实际的年平均收益率（%）',
		x: '记录的年数',
		y: '在预测分布中的百分位',
		line: '实际结果在预测分布中的位置',
		aria: '实际结果在预测分布中的百分位',
		readout: '预测为平均 6%、波动率 16%。1 年后处于第 {a} 百分位，5 年后第 {b}，20 年后第 {c}。',
	},
	en: {
		r: 'Realized average yearly return (%)',
		x: 'Years of record',
		y: 'Percentile in the forecast distribution',
		line: 'Where the realized result falls in the forecast distribution',
		aria: 'Percentile of the realized result in the forecast distribution',
		readout: 'Forecast: 6% average, 16% volatility. Percentile after 1 year: {a}; after 5 years: {b}; after 20 years: {c}.',
	},
}[lang];

const xr = [0, 30];
const yr = [0, 100];
const xTicks = [0, 10, 20, 30];
const yTicks = [0, 25, 50, 75, 100];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 44, r: 20, t: 14, b: 48 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 40, r: 12, t: 14, b: 48 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="forecast-check" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.r} = <output data-out="r">3</output></span>
			<input type="range" min="0" max="10" step="1" value="3" data-param="r" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			{yTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xTicks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<path class="viz-fit" fill="none" data-el="pct" d="" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-fit"></span>{L.line}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initForecastCheck } from '../../scripts/widgets/forecast-check';
	initForecastCheck();
</script>
