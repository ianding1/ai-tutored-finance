---
// Figure 1-1 of lesson 6.6: human capital (present value of remaining wages to 65, discounted at 3% real) and
// financial capital (saving a share of each year's wage, earning 4% real) from age 25 to 65. Wage 100 at 25,
// growing at an adjustable real rate. Parameters are registered in course/widgets.yaml (id: human-capital).
// Same model as course/verify/6.6.py.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		g: '工资的实际增长率（%）',
		s: '储蓄率（%）',
		x: '年龄',
		y: '财富（25 岁工资 = 100）',
		hc: '人力资本',
		fc: '金融资本',
		aria: '人力资本与金融资本随年龄的变化',
		readout: '人力资本占总财富的比例：25 岁 {a}%，40 岁 {b}%，55 岁 {c}%，64 岁 {d}%。',
	},
	en: {
		g: 'Real wage growth (%)',
		s: 'Saving rate (%)',
		x: 'Age',
		y: 'Wealth (wage at 25 = 100)',
		hc: 'Human capital',
		fc: 'Financial capital',
		aria: 'Human and financial capital over age',
		readout: 'Human capital as a share of total wealth: age 25 {a}%, 40 {b}%, 55 {c}%, 64 {d}%.',
	},
}[lang];

const xr = [25, 65];
const yr = [0, 5000];
const xTicks = [25, 35, 45, 55, 65];
const yTicks = [0, 1000, 2000, 3000, 4000, 5000];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 52, r: 20, t: 14, b: 48 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 48, r: 12, t: 14, b: 48 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="human-capital" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.g} = <output data-out="g">2</output></span>
			<input type="range" min="0" max="4" step="1" value="2" data-param="g" />
		</label>
		<label>
			<span>{L.s} = <output data-out="s">15</output></span>
			<input type="range" min="5" max="30" step="5" value="15" data-param="s" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			{yTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xTicks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<path class="viz-fit" fill="none" data-el="hc" d="" />
			<path class="viz-ols" fill="none" data-el="fc" d="" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-fit"></span>{L.hc}</li>
		<li><span class="sw sw-ols"></span>{L.fc}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initHumanCapital } from '../../scripts/widgets/human-capital';
	initHumanCapital();
</script>
