---
// Figure 4-1 of lesson 2.7: a one-year foreign bond held by a US investor. Unhedged dollar return
// (1 + i*)(1 + x) - 1 as a function of the foreign currency's change x against the dollar; hedged return
// (by covered interest parity) equals the US rate i. The point marks the break-even change (1 + i)/(1 + i*) - 1.
// Parameters are registered in course/widgets.yaml (id: fx-return).
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		i: '美元利率 i（%）',
		istar: '外币利率 i*（%）',
		x: '外币对美元的变化（%）',
		y: '以美元计的收益（%）',
		un: '不对冲',
		hedged: '对冲（远期合约）',
		be: '两者相等',
		readout: '对冲后的收益为 {h}%。外币对美元的变化高于 {be}% 时，不对冲的收益才高于对冲。',
	},
	en: {
		i: 'Dollar interest rate i (%)',
		istar: 'Foreign interest rate i* (%)',
		x: 'Change in the foreign currency against the dollar (%)',
		y: 'Return in dollars (%)',
		un: 'Unhedged',
		hedged: 'Hedged (forward contract)',
		be: 'Break-even',
		readout: 'The hedged return is {h}%. The unhedged return beats the hedged one only if the foreign currency changes by more than {be}% against the dollar.',
	},
}[lang];

const xr = [-10, 10];
const yr = [-10, 20];
const xticks = [-10, -5, 0, 5, 10];
const yticks = [-10, -5, 0, 5, 10, 15, 20];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 320, pad: { l: 50, r: 20, t: 14, b: 44 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 50, r: 12, t: 14, b: 44 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="fx-return" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.i} = <output data-out="i">4</output></span>
			<input type="range" min="0" max="8" step="0.5" value="4" data-param="i" />
		</label>
		<label>
			<span>{L.istar} = <output data-out="istar">2</output></span>
			<input type="range" min="0" max="8" step="0.5" value="2" data-param="istar" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.un} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			<defs>
				<clipPath id={`fx-clip-${cls}`}>
					<rect x={pad.l} y={pad.t} width={W - pad.l - pad.r} height={H - pad.t - pad.b} />
				</clipPath>
			</defs>
			{yticks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xticks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={X(0)} x2={X(0)} y1={pad.t} y2={H - pad.b} />
			<line class="viz-grid" x1={pad.l} x2={W - pad.r} y1={H - pad.b} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<g clip-path={`url(#fx-clip-${cls})`}>
				<line class="viz-curve" data-el="un" x1="0" y1="0" x2="0" y2="0" />
				<line class="viz-curve-fat" data-el="hedged" x1="0" y1="0" x2="0" y2="0" />
				<line class="viz-mean" data-el="vbe" x1="0" y1="0" x2="0" y2="0" />
				<circle class="viz-min" data-el="pt" r="6" cx="0" cy="0" />
			</g>
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-curve"></span>{L.un}</li>
		<li><span class="sw sw-fat"></span>{L.hedged}</li>
		<li><span class="sw sw-min"></span>{L.be}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initFxReturn } from '../../scripts/widgets/fx-return';
	initFxReturn();
</script>
