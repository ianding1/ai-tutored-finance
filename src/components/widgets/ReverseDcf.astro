---
// Figure 3-1 of lesson 6.8: reverse DCF. For a price equal to a multiple of this year's free cash flow, the yearly
// growth over the next 10 years that justifies the price, with 3% growth forever afterwards, at an adjustable
// discount rate. Parameters are registered in course/widgets.yaml (id: reverse-dcf). Same model as course/verify/6.8.py.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		r: '折现率（%）',
		x: '股价 / 当年自由现金流',
		y: '隐含的 10 年年增长率（%）',
		line: '使股价合理的今后 10 年自由现金流增长率',
		aria: '反向 DCF：股价隐含的增长率',
		readout: '倍数 20 时隐含增长 {a}%，40 时 {b}%，60 时 {c}%。',
	},
	en: {
		r: 'Discount rate (%)',
		x: 'Price / this year\'s free cash flow',
		y: 'Implied 10-year growth (%)',
		line: 'Growth in free cash flow over the next 10 years that justifies the price',
		aria: 'Reverse DCF: growth implied by the price',
		readout: 'Implied growth: {a}% at a multiple of 20, {b}% at 40, {c}% at 60.',
	},
}[lang];

const xr = [10, 80];
const yr = [-5, 30];
const xTicks = [10, 20, 40, 60, 80];
const yTicks = [0, 10, 20, 30];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 44, r: 20, t: 14, b: 48 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 40, r: 12, t: 14, b: 48 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="reverse-dcf" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.r} = <output data-out="r">9</output></span>
			<input type="range" min="7" max="11" step="1" value="9" data-param="r" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			{yTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xTicks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<path class="viz-fit" fill="none" data-el="g" d="" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-fit"></span>{L.line}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initReverseDcf } from '../../scripts/widgets/reverse-dcf';
	initReverseDcf();
</script>
