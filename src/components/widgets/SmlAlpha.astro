---
// Figure 2-1 of lesson 4.4: the security market line E[R] = rf + beta x (market risk premium) and four stocks
// with analysts' expected returns: U (beta 0.6, 6.5%), V (1.0, 8%), W (1.5, 9%), X (1.2, 11%).
// The vertical segment from each stock to the line is its alpha. Sliders: risk-free rate and market risk premium.
// Parameters are registered in course/widgets.yaml (id: sml-alpha).
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		rf: '无风险利率（%）',
		mrp: '市场风险溢价（%）',
		x: 'beta',
		y: '预期收益（%）',
		sml: '证券市场线',
		stock: '分析师预期的收益',
		readout: 'alpha（百分点）：U {U}，V {V}，W {W}，X {X}。',
	},
	en: {
		rf: 'Risk-free rate (%)',
		mrp: 'Market risk premium (%)',
		x: 'Beta',
		y: 'Expected return (%)',
		sml: 'Security market line',
		stock: "Analysts' expected return",
		readout: 'Alpha (percentage points): U {U}, V {V}, W {W}, X {X}.',
	},
}[lang];

const stocks = [
	{ name: 'U', b: 0.6, e: 6.5 },
	{ name: 'V', b: 1.0, e: 8 },
	{ name: 'W', b: 1.5, e: 9 },
	{ name: 'X', b: 1.2, e: 11 },
];
const xr = [0, 2];
const yr = [0, 20];
const xticks = [0, 0.5, 1, 1.5, 2];
const yticks = [0, 4, 8, 12, 16, 20];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 44, r: 20, t: 14, b: 44 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 44, r: 12, t: 14, b: 44 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="sml-alpha" data-readout={L.readout} data-stocks={JSON.stringify(stocks)}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.rf} = <output data-out="rf">3</output></span>
			<input type="range" min="0" max="5" step="0.5" value="3" data-param="rf" />
		</label>
		<label>
			<span>{L.mrp} = <output data-out="mrp">5</output></span>
			<input type="range" min="2" max="8" step="0.5" value="5" data-param="mrp" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.sml} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			{yticks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xticks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<line class="viz-curve" data-el="sml" x1="0" y1="0" x2="0" y2="0" />
			{stocks.map((s) => (
				<g>
					<line class="viz-avg" data-el={`gap-${s.name}`} x1={X(s.b)} x2={X(s.b)} y1={Y(s.e)} y2={Y(s.e)} />
					<circle class="viz-min" cx={X(s.b)} cy={Y(s.e)} r="5" />
					<text class="viz-tick" x={X(s.b) + 8} y={Y(s.e) + 4}>{s.name}</text>
				</g>
			))}
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-curve"></span>{L.sml}</li>
		<li><span class="sw sw-min"></span>{L.stock}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initSmlAlpha } from '../../scripts/widgets/sml-alpha';
	initSmlAlpha();
</script>
