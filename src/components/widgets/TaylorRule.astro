---
// Figure 3-1 of lesson 2.5: the Taylor rule i = r* + π + 0.5 (π - 2) + 0.5 · gap, drawn against inflation
// for the chosen output gap, with the neutral line i = r* + π. The point marks the chosen inflation rate.
// Parameters are registered in course/widgets.yaml (id: taylor-rule).
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		pi: '通胀 π（%）',
		gap: '产出缺口（%）',
		rstar: '中性实际利率 r*（%）',
		x: '通胀 π（%）',
		y: '名义利率（%）',
		rule: 'Taylor 规则建议的利率',
		neutral: '中性名义利率 r* + π',
		zero: '零',
		readout: '建议的名义利率 {i}%；对应的实际利率 {real}%，比中性实际利率{dir} {d} 个百分点。',
		above: '高',
		below: '低',
	},
	en: {
		pi: 'Inflation π (%)',
		gap: 'Output gap (%)',
		rstar: 'Neutral real rate r* (%)',
		x: 'Inflation π (%)',
		y: 'Nominal interest rate (%)',
		rule: 'Rate suggested by the Taylor rule',
		neutral: 'Neutral nominal rate r* + π',
		zero: 'zero',
		readout: 'Suggested nominal rate {i}%; the implied real rate is {real}%, {d} percentage points {dir} the neutral real rate.',
		above: 'above',
		below: 'below',
	},
}[lang];

const xr = [0, 8];
const yr = [-4, 14];
const xticks = [0, 2, 4, 6, 8];
const yticks = [-4, 0, 4, 8, 12];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 320, pad: { l: 50, r: 20, t: 14, b: 44 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 50, r: 12, t: 14, b: 44 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="taylor-rule" data-readout={L.readout} data-above={L.above} data-below={L.below}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.pi} = <output data-out="pi">2</output></span>
			<input type="range" min="0" max="8" step="0.5" value="2" data-param="pi" />
		</label>
		<label>
			<span>{L.gap} = <output data-out="gap">0</output></span>
			<input type="range" min="-6" max="4" step="0.5" value="0" data-param="gap" />
		</label>
		<label>
			<span>{L.rstar} = <output data-out="rstar">1</output></span>
			<input type="range" min="0" max="2" step="0.25" value="1" data-param="rstar" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.rule} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			<defs>
				<clipPath id={`taylor-clip-${cls}`}>
					<rect x={pad.l} y={pad.t} width={W - pad.l - pad.r} height={H - pad.t - pad.b} />
				</clipPath>
			</defs>
			{yticks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xticks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<line class="viz-grid" x1={pad.l} x2={W - pad.r} y1={H - pad.b} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<g clip-path={`url(#taylor-clip-${cls})`}>
				<line class="viz-avg" data-el="neutral" x1="0" y1="0" x2="0" y2="0" />
				<line class="viz-curve" data-el="rule" x1="0" y1="0" x2="0" y2="0" />
				<line class="viz-gap" data-el="real" x1="0" y1="0" x2="0" y2="0" />
				<circle class="viz-min" data-el="pt" r="6" cx="0" cy="0" />
			</g>
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-curve"></span>{L.rule}</li>
		<li><span class="sw sw-avg"></span>{L.neutral}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initTaylorRule } from '../../scripts/widgets/taylor-rule';
	initTaylorRule();
</script>
