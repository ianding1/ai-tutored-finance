---
// Figure 2-1 of lesson 5.4: the value, to the party paying fixed, of an interest-rate swap with notional 100,
// fixed rate 4% and annual payments, against the market rate (flat curve, annual compounding), for an
// adjustable number of remaining years. Readout: values at market rates of 5% and 3%.
// Parameters are registered in course/widgets.yaml (id: swap-value). Same model as course/verify/5.4.py.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		n: '剩余年数',
		x: '市场利率（%）',
		y: '互换价值',
		line: '支付固定利率一方的价值',
		aria: '利率互换的价值',
		readout: '市场利率为 5% 时，支付固定利率一方的价值为 {v5}；为 3% 时为 {v3}。',
	},
	en: {
		n: 'Years remaining',
		x: 'Market rate (%)',
		y: 'Swap value',
		line: 'Value to the fixed payer',
		aria: 'Value of an interest-rate swap',
		readout: 'At a market rate of 5%, the swap is worth {v5} to the fixed payer; at 3%, {v3}.',
	},
}[lang];

const xr = [2, 6];
const yr = [-20, 20];
const xTicks = [2, 3, 4, 5, 6];
const yTicks = [-20, -10, 0, 10, 20];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 44, r: 20, t: 14, b: 48 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 40, r: 12, t: 14, b: 48 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="swap-value" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.n} = <output data-out="n">5</output></span>
			<input type="range" min="1" max="10" step="1" value="5" data-param="n" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			{yTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xTicks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<path class="viz-fit" fill="none" data-el="value" d="" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-fit"></span>{L.line}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initSwapValue } from '../../scripts/widgets/swap-value';
	initSwapValue();
</script>
