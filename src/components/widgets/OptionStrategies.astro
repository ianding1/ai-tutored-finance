---
// Figure 3-1 of lesson 5.2: profit at expiry (1 year) per share bought at 100, against the stock price then.
// Lines: the stock alone; stock + a put with strike Kp (protective put); stock - a call with strike Kc
// (covered call). Premiums are Black–Scholes values with S = 100, sigma = 20%, r = 4%, T = 1, and interest on
// premiums is ignored. Parameters are registered in course/widgets.yaml (id: option-strategies).
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		kp: '看跌期权执行价',
		kc: '看涨期权执行价',
		x: '到期时的股价',
		y: '每股的利润',
		stock: '只持有股票',
		pp: '保护性看跌（股票 + 买入看跌）',
		cc: '备兑看涨（股票 + 卖出看涨）',
		aria: '期权策略到期时的利润',
		readout: '看跌期权价格 {p}，最坏的亏损为 {floor}；看涨期权价格 {c}，最大的利润为 {cap}。',
	},
	en: {
		kp: 'Put strike',
		kc: 'Call strike',
		x: 'Stock price at expiry',
		y: 'Profit per share',
		stock: 'Stock alone',
		pp: 'Protective put (stock + long put)',
		cc: 'Covered call (stock + short call)',
		aria: 'Profit of option strategies at expiry',
		readout: 'Put price {p}, worst loss {floor}; call price {c}, largest profit {cap}.',
	},
}[lang];

const xr = [60, 140];
const yr = [-40, 40];
const xTicks = [60, 80, 100, 120, 140];
const yTicks = [-40, -20, 0, 20, 40];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 48, r: 20, t: 14, b: 48 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 44, r: 12, t: 14, b: 48 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="option-strategies" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.kp} = <output data-out="kp">90</output></span>
			<input type="range" min="80" max="100" step="5" value="90" data-param="kp" />
		</label>
		<label>
			<span>{L.kc} = <output data-out="kc">110</output></span>
			<input type="range" min="100" max="130" step="5" value="110" data-param="kc" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			{yTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xTicks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<line class="viz-ols" x1={X(60)} y1={Y(-40)} x2={X(140)} y2={Y(40)} />
			<path class="viz-fit" fill="none" data-el="pp" d="" />
			<path class="viz-curve" fill="none" stroke-width="2.5" data-el="cc" d="" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-ols"></span>{L.stock}</li>
		<li><span class="sw sw-fit"></span>{L.pp}</li>
		<li><span class="sw sw-curve"></span>{L.cc}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initOptionStrategies } from '../../scripts/widgets/option-strategies';
	initOptionStrategies();
</script>
