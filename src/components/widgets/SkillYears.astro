---
// Figure 2-1 of lesson 4.9: the t-value of a manager's measured alpha after T years, for an adjustable true
// information ratio IR. Expected t = IR * sqrt(T); the shaded band is the 95% range IR * sqrt(T) +/- 1.96.
// Dashed lines at +/- 1.96: the 95% range for a manager with no skill.
// Parameters are registered in course/widgets.yaml (id: skill-years). Same model as course/verify/4.9.py.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		ir: '真实的信息比率',
		x: '业绩记录的年数',
		y: 'alpha 的 t 值',
		mean: '期望的 t 值',
		band: '95% 的可能范围',
		zero: '没有能力时的 95% 范围',
		aria: '业绩记录长度与 alpha 的 t 值',
		readout: '期望的 t 值达到 1.96 需要约 {T} 年；20 年业绩的 t 值有 95% 的可能落在 {lo} 到 {hi} 之间。',
	},
	en: {
		ir: 'True information ratio',
		x: 'Years of track record',
		y: 't-value of alpha',
		mean: 'Expected t-value',
		band: '95% range',
		zero: '95% range with no skill',
		aria: 'Length of track record and the t-value of alpha',
		readout: 'The expected t-value reaches 1.96 after about {T} years; after 20 years the t-value has a 95% chance of lying between {lo} and {hi}.',
	},
}[lang];

const xr = [0, 40];
const yr = [-3, 9];
const xTicks = [0, 10, 20, 30, 40];
const yTicks = [-2, 0, 2, 4, 6, 8];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 44, r: 20, t: 14, b: 48 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 40, r: 12, t: 14, b: 48 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="skill-years" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.ir} = <output data-out="ir">0.30</output></span>
			<input type="range" min="0.1" max="1" step="0.05" value="0.3" data-param="ir" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			<defs>
				<clipPath id={`sy-clip-${cls}`}><rect x={pad.l} y={pad.t} width={W - pad.l - pad.r} height={H - pad.t - pad.b} /></clipPath>
			</defs>
			{yTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xTicks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<g clip-path={`url(#sy-clip-${cls})`}>
				<path class="viz-area-2" data-el="band" d="" />
				<line class="viz-ols" x1={X(0)} x2={X(40)} y1={Y(1.96)} y2={Y(1.96)} />
				<line class="viz-ols" x1={X(0)} x2={X(40)} y1={Y(-1.96)} y2={Y(-1.96)} />
				<path class="viz-fit" fill="none" data-el="mean" d="" />
			</g>
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-fit"></span>{L.mean}</li>
		<li><span class="sw sw-cs"></span>{L.band}</li>
		<li><span class="sw sw-ols"></span>{L.zero}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initSkillYears } from '../../scripts/widgets/skill-years';
	initSkillYears();
</script>
