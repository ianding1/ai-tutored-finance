---
// Figure 3-1 of lesson 5.3: the Black–Scholes price of a European call with strike 100 against the stock
// price, for an adjustable volatility and time to expiry (risk-free rate 4%). Dashed: the intrinsic value
// max(S - 100, 0). Readout at S = 100: price, time value and delta.
// Parameters are registered in course/widgets.yaml (id: bs-call). Same model as course/verify/5.3.py.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		sigma: '波动率 σ（%）',
		t: '距到期时间 T（年）',
		x: '股价 S',
		y: '期权价格',
		price: '看涨期权价格',
		iv: '内在价值',
		aria: 'Black–Scholes 看涨期权价格',
		readout: '股价为 100 时：期权价格 {c}，全部是时间价值；delta 为 {d}。',
	},
	en: {
		sigma: 'Volatility σ (%)',
		t: 'Time to expiry T (years)',
		x: 'Stock price S',
		y: 'Option price',
		price: 'Call price',
		iv: 'Intrinsic value',
		aria: 'Black–Scholes call price',
		readout: 'At a stock price of 100: option price {c}, all of it time value; delta {d}.',
	},
}[lang];

const xr = [50, 150];
const yr = [0, 60];
const xTicks = [50, 75, 100, 125, 150];
const yTicks = [0, 20, 40, 60];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 44, r: 20, t: 14, b: 48 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 40, r: 12, t: 14, b: 48 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="bs-call" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.sigma} = <output data-out="sigma">20</output></span>
			<input type="range" min="10" max="60" step="5" value="20" data-param="sigma" />
		</label>
		<label>
			<span>{L.t} = <output data-out="t">1.0</output></span>
			<input type="range" min="0.1" max="2" step="0.1" value="1" data-param="t" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			{yTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xTicks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<path class="viz-ols" fill="none" d={`M ${X(50)} ${Y(0)} L ${X(100)} ${Y(0)} L ${X(150)} ${Y(50)}`} />
			<path class="viz-fit" fill="none" data-el="price" d="" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-fit"></span>{L.price}</li>
		<li><span class="sw sw-ols"></span>{L.iv}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initBsCall } from '../../scripts/widgets/bs-call';
	initBsCall();
</script>
