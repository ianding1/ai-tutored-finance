---
// Figure 2-1 of lesson 6.12: probability of reaching a goal against the stock share. Real returns: safe asset 1%,
// stocks 5% expected with 17% volatility; lognormal approximation. The funded ratio is today's assets over the
// goal's present value at the safe rate. Adjustable horizon and funded ratio.
// Parameters are registered in course/widgets.yaml (id: goal-prob). Same model as course/verify/6.12.py.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		t: '距离目标的年数',
		f: '资金充足率（%）',
		x: '股票比例（%）',
		y: '达成目标的概率（%）',
		line: '期末财富不低于目标的概率',
		aria: '达成目标的概率与股票比例',
		readout: '股票 0% 时 {a}%，50% 时 {b}%，100% 时 {c}%。',
	},
	en: {
		t: 'Years to the goal',
		f: 'Funded ratio (%)',
		x: 'Stock share (%)',
		y: 'Probability of reaching the goal (%)',
		line: 'Probability that final wealth is at least the goal',
		aria: 'Probability of reaching a goal against the stock share',
		readout: 'With 0% stocks {a}%, 50% stocks {b}%, 100% stocks {c}%.',
	},
}[lang];

const xr = [0, 100];
const yr = [0, 100];
const xTicks = [0, 25, 50, 75, 100];
const yTicks = [0, 25, 50, 75, 100];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 44, r: 20, t: 14, b: 48 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 40, r: 12, t: 14, b: 48 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="goal-prob" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.t} = <output data-out="t">5</output></span>
			<input type="range" min="1" max="30" step="1" value="5" data-param="t" />
		</label>
		<label>
			<span>{L.f} = <output data-out="f">100</output></span>
			<input type="range" min="60" max="120" step="10" value="100" data-param="f" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			{yTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xTicks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<path class="viz-fit" fill="none" data-el="p" d="" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-fit"></span>{L.line}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initGoalProb } from '../../scripts/widgets/goal-prob';
	initGoalProb();
</script>
