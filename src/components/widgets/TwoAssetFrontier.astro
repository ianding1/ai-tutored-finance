---
// Figure 1-1 of lesson 4.2: expected return against standard deviation for portfolios of two risky assets,
// A (expected return 10%, standard deviation 20%) and B (5%, 10%). Solid: weights of A from 0 to 1;
// dashed: short sales (weight of A from -0.5 to 0 or from 1 to 1.5). Sliders: correlation and the weight of A to mark.
// Parameters are registered in course/widgets.yaml (id: two-asset-frontier).
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		rho: '相关系数 ρ',
		w: 'A 的权重',
		x: '标准差（%）',
		y: '预期收益（%）',
		long: '不卖空的组合',
		short: '需要卖空的组合',
		readout: 'A 的权重 {w}：预期收益 {m}%，标准差 {s}%。',
	},
	en: {
		rho: 'Correlation ρ',
		w: 'Weight of A',
		x: 'Standard deviation (%)',
		y: 'Expected return (%)',
		long: 'Portfolios without short sales',
		short: 'Portfolios that need short sales',
		readout: 'Weight of A {w}: expected return {m}%, standard deviation {s}%.',
	},
}[lang];

const xr = [0, 35];
const yr = [0, 14];
const xticks = [0, 5, 10, 15, 20, 25, 30, 35];
const yticks = [0, 2, 4, 6, 8, 10, 12, 14];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 320, pad: { l: 44, r: 20, t: 14, b: 44 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 44, r: 12, t: 14, b: 44 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="two-asset-frontier" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.rho} = <output data-out="rho">0.2</output></span>
			<input type="range" min="-1" max="1" step="0.1" value="0.2" data-param="rho" />
		</label>
		<label>
			<span>{L.w} = <output data-out="w">0.5</output></span>
			<input type="range" min="-0.5" max="1.5" step="0.05" value="0.5" data-param="w" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.long} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			<defs>
				<clipPath id={`taf-clip-${cls}`}>
					<rect x={pad.l} y={pad.t} width={W - pad.l - pad.r} height={H - pad.t - pad.b} />
				</clipPath>
			</defs>
			{yticks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xticks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<g clip-path={`url(#taf-clip-${cls})`}>
				<polyline class="viz-avg" fill="none" data-el="shortLo" points="" />
				<polyline class="viz-avg" fill="none" data-el="shortHi" points="" />
				<polyline class="viz-curve" fill="none" data-el="long" points="" />
				<circle class="viz-min" data-el="pt" r="5" cx="0" cy="0" />
			</g>
			<circle class="viz-mean" cx={X(20)} cy={Y(10)} r="3.5" />
			<text class="viz-tick" x={X(20) + 8} y={Y(10) - 6}>A</text>
			<circle class="viz-mean" cx={X(10)} cy={Y(5)} r="3.5" />
			<text class="viz-tick" x={X(10) + 8} y={Y(5) + 14}>B</text>
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-curve"></span>{L.long}</li>
		<li><span class="sw sw-avg"></span>{L.short}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initTwoAssetFrontier } from '../../scripts/widgets/two-asset-frontier';
	initTwoAssetFrontier();
</script>
