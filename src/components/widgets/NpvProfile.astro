---
// Figure 3-1 of lesson 3.2: NPV profiles of two projects. A: -100, 60, 50, 20; B: -100, 10, 20, 115
// (years 0-3). The slider sets the discount rate; points mark each project's NPV at that rate.
// Parameters are registered in course/widgets.yaml (id: npv-profile).
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		r: '折现率 r（%）',
		x: '折现率（%）',
		y: 'NPV',
		a: '项目 A：−100，60，50，20',
		b: '项目 B：−100，10，20，115',
		readout: '折现率 {r}%：项目 A 的 NPV 为 {a}，项目 B 的 NPV 为 {b}。',
	},
	en: {
		r: 'Discount rate r (%)',
		x: 'Discount rate (%)',
		y: 'NPV',
		a: 'Project A: −100, 60, 50, 20',
		b: 'Project B: −100, 10, 20, 115',
		readout: 'At a discount rate of {r}%, project A has an NPV of {a} and project B an NPV of {b}.',
	},
}[lang];

const A = [-100, 60, 50, 20];
const B = [-100, 10, 20, 115];
const xr = [0, 25];
const yr = [-30, 50];
const xticks = [0, 5, 10, 15, 20, 25];
const yticks = [-30, -20, -10, 0, 10, 20, 30, 40, 50];
const npv = (c: number[], r: number) => c.reduce((s, x, t) => s + x / (1 + r / 100) ** t, 0);
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 320, pad: { l: 50, r: 20, t: 14, b: 44 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 50, r: 12, t: 14, b: 44 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
const rs = Array.from({ length: 101 }, (_, k) => (25 * k) / 100);
---

<div class="lfwai-widget" data-widget="npv-profile" data-readout={L.readout} data-flows={JSON.stringify({ A, B })}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.r} = <output data-out="r">10</output></span>
			<input type="range" min="0" max="25" step="0.5" value="10" data-param="r" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.y} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			{yticks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xticks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<polyline class="viz-curve" fill="none" points={rs.map((r) => `${X(r).toFixed(1)},${Y(npv(A, r)).toFixed(1)}`).join(' ')} />
			<polyline class="viz-curve-fat" fill="none" points={rs.map((r) => `${X(r).toFixed(1)},${Y(npv(B, r)).toFixed(1)}`).join(' ')} />
			<line class="viz-mean" data-el="vr" x1="0" y1={pad.t} x2="0" y2={H - pad.b} />
			<circle class="viz-dot viz-a" data-el="pa" r="5" cx="0" cy="0" />
			<circle class="viz-dot viz-b" data-el="pb" r="5" cx="0" cy="0" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-curve"></span>{L.a}</li>
		<li><span class="sw sw-fat"></span>{L.b}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initNpvProfile } from '../../scripts/widgets/npv-profile';
	initNpvProfile();
</script>
