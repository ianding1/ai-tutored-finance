---
// Figure 2-1 of lesson 3.9: Gordon model price P = D1 / (r - g) against the growth rate g, with D1 = 2.
// Sliders: required return r and growth rate g (marked). The curve is drawn only where g < r.
// Parameters are registered in course/widgets.yaml (id: gordon-price).
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		r: '要求的收益率 r（%）',
		g: '股息增长率 g（%）',
		x: '股息增长率 g（%）',
		y: '股价',
		curve: '股价 = 2 / (r − g)',
		readout: '股价 {p}。g 再提高 0.5 个百分点时，股价为 {p2}（变化 {c}%）。',
		invalid: 'g 不低于 r：公式不成立。',
	},
	en: {
		r: 'Required return r (%)',
		g: 'Dividend growth rate g (%)',
		x: 'Dividend growth rate g (%)',
		y: 'Stock price',
		curve: 'Price = 2 / (r − g)',
		readout: 'Price {p}. With g 0.5 percentage points higher, the price is {p2} (a change of {c}%).',
		invalid: 'g is not below r: the formula does not apply.',
	},
}[lang];

const xr = [0, 8];
const yr = [0, 200];
const xticks = [0, 1, 2, 3, 4, 5, 6, 7, 8];
const yticks = [0, 40, 80, 120, 160, 200];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 50, r: 20, t: 14, b: 44 } },
	{ cls: 'viz-narrow', W: 360, H: 280, pad: { l: 50, r: 12, t: 14, b: 44 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="gordon-price" data-readout={L.readout} data-invalid={L.invalid}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.r} = <output data-out="r">9</output></span>
			<input type="range" min="6" max="12" step="0.5" value="9" data-param="r" />
		</label>
		<label>
			<span>{L.g} = <output data-out="g">4</output></span>
			<input type="range" min="0" max="8" step="0.25" value="4" data-param="g" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.curve} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			<defs>
				<clipPath id={`gp-clip-${cls}`}>
					<rect x={pad.l} y={pad.t} width={W - pad.l - pad.r} height={H - pad.t - pad.b} />
				</clipPath>
			</defs>
			{yticks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xticks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<g clip-path={`url(#gp-clip-${cls})`}>
				<line class="viz-avg" data-el="asym" x1="0" y1={pad.t} x2="0" y2={H - pad.b} />
				<polyline class="viz-curve" fill="none" data-el="curve" points="" />
				<circle class="viz-min" data-el="pt" r="5" cx="0" cy="0" />
			</g>
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-curve"></span>{L.curve}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initGordonPrice } from '../../scripts/widgets/gordon-price';
	initGordonPrice();
</script>
