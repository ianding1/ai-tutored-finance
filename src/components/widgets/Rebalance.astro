---
// Figure 4-1 of lesson 6.7: the stock weight of a 60/40 portfolio over 40 years along one simulated path of yearly
// returns (stocks 7% mean, 17% volatility; bonds 4%, 6%; independent; fixed seed), never rebalanced versus
// rebalanced back to 60% at year end whenever the weight is outside an adjustable band (plotted: the weight
// at each year end before rebalancing).
// Parameters are registered in course/widgets.yaml (id: rebalance). Same model as course/verify/6.7.py.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		band: '再平衡区间（± 个百分点）',
		x: '年',
		y: '股票比例（%）',
		none: '从不再平衡',
		band2: '超出区间时再平衡',
		aria: '股票比例随时间的漂移',
		readout: '从不再平衡：40 年后股票占 {e}%，最高 {m}%；按区间再平衡：40 年中再平衡 {n} 次。',
	},
	en: {
		band: 'Rebalancing band (± percentage points)',
		x: 'Year',
		y: 'Stock weight (%)',
		none: 'Never rebalanced',
		band2: 'Rebalanced when outside the band',
		aria: 'Drift of the stock weight over time',
		readout: 'Never rebalanced: stocks are {e}% after 40 years, at most {m}%; with the band: {n} rebalances in 40 years.',
	},
}[lang];

const xr = [0, 40];
const yr = [30, 100];
const xTicks = [0, 10, 20, 30, 40];
const yTicks = [40, 60, 80, 100];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 44, r: 20, t: 14, b: 48 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 40, r: 12, t: 14, b: 48 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="rebalance" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.band} = <output data-out="band">5</output></span>
			<input type="range" min="1" max="10" step="1" value="5" data-param="band" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			{yTicks.map((v) => (
				<g>
					<line class="viz-grid" x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xTicks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<line class="viz-axis" x1={pad.l} x2={W - pad.r} y1={H - pad.b} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<path class="viz-ols" fill="none" data-el="none" d="" />
			<path class="viz-fit" fill="none" data-el="band" d="" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-ols"></span>{L.none}</li>
		<li><span class="sw sw-fit"></span>{L.band2}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initRebalance } from '../../scripts/widgets/rebalance';
	initRebalance();
</script>
