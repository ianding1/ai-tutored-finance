---
// Figure 2-1 of lesson 3.8: return on equity against return on assets, with and without debt.
// ROE = ROA + (ROA - r) x D/E, taxes ignored. Sliders: debt/equity, interest rate, and the ROA to mark.
// Parameters are registered in course/widgets.yaml (id: leverage-roe).
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		de: '负债 / 股东权益',
		r: '借款利率（%）',
		roa: '资产收益率（%）',
		x: '资产收益率（%）',
		y: '净资产收益率（%）',
		none: '没有负债',
		lev: '有负债',
		readout: '资产收益率为 {a}% 时，没有负债的 ROE 为 {a}%，有负债的 ROE 为 {e}%。',
	},
	en: {
		de: 'Debt / equity',
		r: 'Interest rate on debt (%)',
		roa: 'Return on assets (%)',
		x: 'Return on assets (%)',
		y: 'Return on equity (%)',
		none: 'No debt',
		lev: 'With debt',
		readout: 'With a return on assets of {a}%, ROE is {a}% without debt and {e}% with debt.',
	},
}[lang];

const xr = [-10, 20];
const yr = [-60, 60];
const xticks = [-10, -5, 0, 5, 10, 15, 20];
const yticks = [-60, -40, -20, 0, 20, 40, 60];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 50, r: 20, t: 14, b: 44 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 50, r: 12, t: 14, b: 44 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="leverage-roe" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.de} = <output data-out="de">1</output></span>
			<input type="range" min="0" max="3" step="0.25" value="1" data-param="de" />
		</label>
		<label>
			<span>{L.r} = <output data-out="r">5</output></span>
			<input type="range" min="2" max="10" step="0.5" value="5" data-param="r" />
		</label>
		<label>
			<span>{L.roa} = <output data-out="roa">10</output></span>
			<input type="range" min="-10" max="20" step="1" value="10" data-param="roa" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.y} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			<defs>
				<clipPath id={`lr-clip-${cls}`}>
					<rect x={pad.l} y={pad.t} width={W - pad.l - pad.r} height={H - pad.t - pad.b} />
				</clipPath>
			</defs>
			{yticks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xticks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={X(0)} x2={X(0)} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<g clip-path={`url(#lr-clip-${cls})`}>
				<line class="viz-avg" x1={X(-10)} y1={Y(-10)} x2={X(20)} y2={Y(20)} />
				<polyline class="viz-curve" fill="none" data-el="lev" points="" />
				<line class="viz-mean" data-el="vx" x1="0" y1={pad.t} x2="0" y2={H - pad.b} />
				<circle class="viz-min" data-el="pt" r="5" cx="0" cy="0" />
			</g>
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-avg"></span>{L.none}</li>
		<li><span class="sw sw-curve"></span>{L.lev}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initLeverageRoe } from '../../scripts/widgets/leverage-roe';
	initLeverageRoe();
</script>
