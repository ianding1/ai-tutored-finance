---
// Figure 4-1 of lesson 3.10: firm value as a multiple of next year's NOPAT against the growth rate g,
// value / NOPAT = (1 - g / ROIC) / (WACC - g). Dashed line: the no-growth value 1 / WACC.
// Sliders: ROIC, WACC and the growth rate to mark. Parameters are registered in course/widgets.yaml (id: value-driver).
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		roic: '新投资的 ROIC（%）',
		wacc: 'WACC（%）',
		g: '增长率 g（%）',
		x: '增长率 g（%）',
		y: '价值 ÷ 明年税后营业利润',
		curve: '公司价值的倍数',
		base: '不增长时',
		readout: '增长率 {g}% 时，公司价值是明年税后营业利润的 {m} 倍；不增长时为 {m0} 倍。',
	},
	en: {
		roic: 'ROIC on new investment (%)',
		wacc: 'WACC (%)',
		g: 'Growth rate g (%)',
		x: 'Growth rate g (%)',
		y: 'Value ÷ next year\'s NOPAT',
		curve: 'Value multiple',
		base: 'No growth',
		readout: 'With growth of {g}%, firm value is {m} times next year\'s NOPAT; with no growth it is {m0} times.',
	},
}[lang];

const xr = [0, 6];
const yr = [0, 40];
const xticks = [0, 1, 2, 3, 4, 5, 6];
const yticks = [0, 10, 20, 30, 40];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 44, r: 20, t: 14, b: 44 } },
	{ cls: 'viz-narrow', W: 360, H: 280, pad: { l: 44, r: 12, t: 14, b: 44 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="value-driver" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.roic} = <output data-out="roic">15</output></span>
			<input type="range" min="4" max="30" step="1" value="15" data-param="roic" />
		</label>
		<label>
			<span>{L.wacc} = <output data-out="wacc">8</output></span>
			<input type="range" min="6" max="12" step="0.5" value="8" data-param="wacc" />
		</label>
		<label>
			<span>{L.g} = <output data-out="g">3</output></span>
			<input type="range" min="0" max="5" step="0.5" value="3" data-param="g" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.curve} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			<defs>
				<clipPath id={`vd-clip-${cls}`}>
					<rect x={pad.l} y={pad.t} width={W - pad.l - pad.r} height={H - pad.t - pad.b} />
				</clipPath>
			</defs>
			{yticks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xticks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<g clip-path={`url(#vd-clip-${cls})`}>
				<line class="viz-avg" data-el="base" x1={pad.l} x2={W - pad.r} y1="0" y2="0" />
				<polyline class="viz-curve" fill="none" data-el="curve" points="" />
				<circle class="viz-min" data-el="pt" r="5" cx="0" cy="0" />
			</g>
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-curve"></span>{L.curve}</li>
		<li><span class="sw sw-avg"></span>{L.base}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initValueDriver } from '../../scripts/widgets/value-driver';
	initValueDriver();
</script>
