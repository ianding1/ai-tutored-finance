---
// Figure 4-1 of lesson 4.10: four uncorrelated assets with volatility 20%. True expected excess returns
// 3, 4, 6, 7; estimates 1, 8, 3, 10 (%). The optimizer uses estimates shrunk toward their average (5.5)
// with intensity w; weights are proportional to the shrunk estimates. Bars: weights; ticks: the truly optimal
// weights. Readout: the Sharpe ratio computed from the estimates and from the true expected returns.
// Parameters are registered in course/widgets.yaml (id: shrinkage). Same model as course/verify/4.10.py.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		w: '收缩程度 w',
		y: '权重（%）',
		bar: '优化器给出的权重',
		tick: '按真实预期收益的最优权重',
		aria: '收缩估计与组合权重',
		assets: ['A', 'B', 'C', 'D'],
		readout: '按估计值计算的夏普比率 {est}；按真实预期收益计算的夏普比率 {true}（最优组合为 0.524）。',
	},
	en: {
		w: 'Shrinkage w',
		y: 'Weight (%)',
		bar: 'Weights from the optimizer',
		tick: 'Optimal weights under the true expected returns',
		aria: 'Shrinkage estimates and portfolio weights',
		assets: ['A', 'B', 'C', 'D'],
		readout: 'Sharpe ratio computed from the estimates {est}; Sharpe ratio under the true expected returns {true} (0.524 for the optimal portfolio).',
	},
}[lang];

const TRUE_W = [0.15, 0.2, 0.3, 0.35];
const yr = [0, 50];
const yTicks = [0, 10, 20, 30, 40, 50];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 260, pad: { l: 52, r: 20, t: 14, b: 36 } },
	{ cls: 'viz-narrow', W: 360, H: 260, pad: { l: 48, r: 12, t: 14, b: 36 } },
].map((g) => {
	const slot = (g.W - g.pad.l - g.pad.r) / 4;
	return {
		...g,
		slot,
		cx: (i: number) => g.pad.l + slot * (i + 0.5),
		Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
	};
});
---

<div class="lfwai-widget" data-widget="shrinkage" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.w} = <output data-out="w">0.0</output></span>
			<input type="range" min="0" max="1" step="0.1" value="0" data-param="w" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, slot, cx, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, H, pad, yr, slot })}>
			{yTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			{L.assets.map((a, i) => (
				<g>
					<rect class="viz-bar" data-el={`bar-${i}`} x={cx(i) - slot * 0.25} width={slot * 0.5} y={Y(0)} height="0" />
					<line class="viz-target" x1={cx(i) - slot * 0.32} x2={cx(i) + slot * 0.32} y1={Y(TRUE_W[i] * 100)} y2={Y(TRUE_W[i] * 100)} />
					<text class="viz-tick" x={cx(i)} y={H - pad.b + 18} text-anchor="middle">{a}</text>
				</g>
			))}
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-bar"></span>{L.bar}</li>
		<li><span class="sw sw-target"></span>{L.tick}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initShrinkage } from '../../scripts/widgets/shrinkage';
	initShrinkage();
</script>
