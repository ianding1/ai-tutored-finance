---
// Figure 3-1 of lesson 5.5: growth of 100 over 20 years at an adjustable gross return, before fees and after a
// management fee plus a 20% incentive fee (charged each year on the return after the management fee, when positive).
// Parameters are registered in course/widgets.yaml (id: fee-drag). Same model as course/verify/5.5.py.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		g: '扣费前年收益率（%）',
		m: '管理费（%）',
		x: '年',
		y: '财富',
		gross: '扣费前',
		net: '扣除管理费和 20% 业绩报酬后',
		aria: '对冲基金费用对财富增长的影响',
		readout: '扣费后年收益率 {n}%，费用拿走了每年收益的 {p}%；20 年后扣费前为 {g20}，扣费后为 {n20}，费用拿走了总增值的 {s}%。',
	},
	en: {
		g: 'Return before fees (%)',
		m: 'Management fee (%)',
		x: 'Year',
		y: 'Wealth',
		gross: 'Before fees',
		net: 'After the management fee and a 20% incentive fee',
		aria: 'Effect of hedge fund fees on wealth',
		readout: 'Return after fees {n}% a year; fees take {p}% of each year\'s return. After 20 years: {g20} before fees, {n20} after; fees take {s}% of the total gain.',
	},
}[lang];

const xr = [0, 20];
const yr = [0, 1500];
const xTicks = [0, 5, 10, 15, 20];
const yTicks = [0, 500, 1000, 1500];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 52, r: 20, t: 14, b: 48 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 48, r: 12, t: 14, b: 48 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="fee-drag" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.g} = <output data-out="g">10</output></span>
			<input type="range" min="4" max="14" step="1" value="10" data-param="g" />
		</label>
		<label>
			<span>{L.m} = <output data-out="m">2</output></span>
			<input type="range" min="0" max="3" step="0.5" value="2" data-param="m" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			{yTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xTicks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<path class="viz-ols" fill="none" data-el="gross" d="" />
			<path class="viz-fit" fill="none" data-el="net" d="" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-ols"></span>{L.gross}</li>
		<li><span class="sw sw-fit"></span>{L.net}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initFeeDrag } from '../../scripts/widgets/fee-drag';
	initFeeDrag();
</script>
