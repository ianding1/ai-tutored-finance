---
// Figure 1-1 of lesson 4.13: wealth per dollar invested over 30 years when yearly log returns are independent
// and normal with mean mu - sigma^2/2 and standard deviation sigma (mu is the arithmetic mean return).
// Lines: the 5%, 25%, 50%, 75% and 95% percentiles (computed exactly, no random draws) and the mean exp(mu t).
// Parameters are registered in course/widgets.yaml (id: fan-chart). Same model as course/verify/4.13.py.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		mu: '平均年收益 μ（%）',
		sigma: '年波动率 σ（%）',
		x: '年',
		y: '每 1 元投入的财富（元）',
		mean: '平均值',
		median: '中位数',
		band: '25%–75% 和 5%–95% 分位数',
		aria: '30 年财富的分布',
		readout: '30 年后：平均值 {mean} 元，中位数 {med} 元，5% 分位数 {p5} 元；终值低于投入的概率 {p}%。',
	},
	en: {
		mu: 'Mean annual return μ (%)',
		sigma: 'Annual volatility σ (%)',
		x: 'Years',
		y: 'Wealth per dollar invested (dollars)',
		mean: 'Mean',
		median: 'Median',
		band: '25%–75% and 5%–95% percentiles',
		aria: 'Distribution of wealth over 30 years',
		readout: 'After 30 years: mean {mean} dollars, median {med} dollars, 5% percentile {p5} dollars; probability of ending below the amount invested {p}%.',
	},
}[lang];

const xr = [0, 30];
const yr = [0, 20];
const xTicks = [0, 5, 10, 15, 20, 25, 30];
const yTicks = [0, 4, 8, 12, 16, 20];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 44, r: 20, t: 14, b: 48 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 40, r: 12, t: 14, b: 48 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="fan-chart" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.mu} = <output data-out="mu">7</output></span>
			<input type="range" min="2" max="10" step="0.5" value="7" data-param="mu" />
		</label>
		<label>
			<span>{L.sigma} = <output data-out="sigma">18</output></span>
			<input type="range" min="5" max="30" step="1" value="18" data-param="sigma" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			<defs>
				<clipPath id={`fan-clip-${cls}`}><rect x={pad.l} y={pad.t} width={W - pad.l - pad.r} height={H - pad.t - pad.b} /></clipPath>
			</defs>
			{yTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xTicks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<g clip-path={`url(#fan-clip-${cls})`}>
				<path class="viz-area-2" data-el="outer" d="" />
				<path class="viz-area-1" data-el="inner" d="" />
				<path class="viz-fit" fill="none" data-el="median" d="" />
				<path class="viz-ols" fill="none" data-el="mean" d="" />
			</g>
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-fit"></span>{L.median}</li>
		<li><span class="sw sw-ols"></span>{L.mean}</li>
		<li><span class="sw sw-cs"></span>{L.band}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initFanChart } from '../../scripts/widgets/fan-chart';
	initFanChart();
</script>
