---
// Figure 3-1 of lesson 6.9: sequence-of-returns risk. 1,000 at retirement, 40 withdrawn at the start of each year
// (in real terms), real return 5% every year except one year of -30%, whose position is adjustable. Dashed: the
// same returns with the fall in the last year. Parameters are registered in course/widgets.yaml (id: sequence-risk).
// Same model as course/verify/6.9.py.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		k: '下跌 30% 发生在第几年',
		x: '退休后的年数',
		y: '组合价值（实际）',
		path: '下跌发生在所选年份',
		last: '下跌发生在第 30 年',
		aria: '收益顺序风险',
		readout: '下跌在第 {k} 年：30 年后剩 {a}；下跌在第 30 年：剩 {b}。如果不取钱，两种顺序 30 年后都是 2881。',
	},
	en: {
		k: 'Year of the 30% fall',
		x: 'Years after retirement',
		y: 'Portfolio value (real)',
		path: 'Fall in the chosen year',
		last: 'Fall in year 30',
		aria: 'Sequence-of-returns risk',
		readout: 'Fall in year {k}: {a} left after 30 years; fall in year 30: {b} left. Without withdrawals both orders end at 2881.',
	},
}[lang];

const xr = [0, 30];
const yr = [0, 1200];
const xTicks = [0, 10, 20, 30];
const yTicks = [0, 400, 800, 1200];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 52, r: 20, t: 14, b: 48 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 48, r: 12, t: 14, b: 48 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="sequence-risk" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.k} = <output data-out="k">1</output></span>
			<input type="range" min="1" max="30" step="1" value="1" data-param="k" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			{yTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xTicks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<path class="viz-ols" fill="none" data-el="last" d="" />
			<path class="viz-fit" fill="none" data-el="path" d="" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-fit"></span>{L.path}</li>
		<li><span class="sw sw-ols"></span>{L.last}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initSequenceRisk } from '../../scripts/widgets/sequence-risk';
	initSequenceRisk();
</script>
