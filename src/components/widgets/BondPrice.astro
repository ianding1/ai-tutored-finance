---
// Figure 2-1 of lesson 3.3: price of a bond with face value 100 and annual coupons, as a function of the
// yield to maturity. Sliders set the coupon rate, the years to maturity and the yield; the point marks the
// price at that yield; the dashed line is par (100). Parameters are registered in course/widgets.yaml (id: bond-price).
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		c: '票面利率（%）',
		n: '剩余年数',
		y: '到期收益率（%）',
		x: '到期收益率（%）',
		py: '价格（面值 100）',
		curve: '价格与到期收益率',
		par: '面值 100',
		readout: '价格 {p}（{kind}）；当期收益率 {cy}%。',
		premium: '溢价',
		discount: '折价',
		atpar: '平价',
	},
	en: {
		c: 'Coupon rate (%)',
		n: 'Years to maturity',
		y: 'Yield to maturity (%)',
		x: 'Yield to maturity (%)',
		py: 'Price (face value 100)',
		curve: 'Price against yield to maturity',
		par: 'Face value 100',
		readout: 'Price {p} ({kind}); current yield {cy}%.',
		premium: 'premium',
		discount: 'discount',
		atpar: 'par',
	},
}[lang];

const xr = [0, 10];
const yr = [40, 200];
const xticks = [0, 2, 4, 6, 8, 10];
const yticks = [40, 80, 120, 160, 200];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 320, pad: { l: 50, r: 20, t: 14, b: 44 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 50, r: 12, t: 14, b: 44 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="bond-price" data-readout={L.readout} data-kinds={JSON.stringify([L.premium, L.discount, L.atpar])}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.c} = <output data-out="c">5</output></span>
			<input type="range" min="0" max="10" step="0.5" value="5" data-param="c" />
		</label>
		<label>
			<span>{L.n} = <output data-out="n">10</output></span>
			<input type="range" min="1" max="30" step="1" value="10" data-param="n" />
		</label>
		<label>
			<span>{L.y} = <output data-out="y">5</output></span>
			<input type="range" min="0" max="10" step="0.25" value="5" data-param="y" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.curve} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			<defs>
				<clipPath id={`bond-clip-${cls}`}>
					<rect x={pad.l} y={pad.t} width={W - pad.l - pad.r} height={H - pad.t - pad.b} />
				</clipPath>
			</defs>
			{yticks.map((v) => (
				<g>
					<line class={v === 40 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xticks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.py}</text>
			<g clip-path={`url(#bond-clip-${cls})`}>
				<line class="viz-avg" x1={pad.l} x2={W - pad.r} y1={Y(100)} y2={Y(100)} />
				<polyline class="viz-curve" fill="none" data-el="curve" points="" />
				<circle class="viz-min" data-el="pt" r="6" cx="0" cy="0" />
			</g>
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-curve"></span>{L.curve}</li>
		<li><span class="sw sw-avg"></span>{L.par}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initBondPrice } from '../../scripts/widgets/bond-price';
	initBondPrice();
</script>
