---
// Figure 2-1 of lesson 4.3: the two-asset frontier of lesson 4.2 (A: 10%, 20%; B: 5%, 10%; correlation 0.2)
// and the capital allocation line from the risk-free rate through a chosen risky portfolio.
// Sliders: risk-free rate and the weight of A in the risky portfolio.
// Parameters are registered in course/widgets.yaml (id: tangency-cal).
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		rf: '无风险利率（%）',
		w: '风险组合中 A 的权重',
		x: '标准差（%）',
		y: '预期收益（%）',
		frontier: '风险资产的组合',
		cal: '资本配置线',
		readout: '所选风险组合（A 的权重 {w}）：预期收益 {m}%，标准差 {s}%，夏普比率 {sh}。',
	},
	en: {
		rf: 'Risk-free rate (%)',
		w: 'Weight of A in the risky portfolio',
		x: 'Standard deviation (%)',
		y: 'Expected return (%)',
		frontier: 'Portfolios of the risky assets',
		cal: 'Capital allocation line',
		readout: 'Chosen risky portfolio (weight of A {w}): expected return {m}%, standard deviation {s}%, Sharpe ratio {sh}.',
	},
}[lang];

const xr = [0, 35];
const yr = [0, 16];
const xticks = [0, 5, 10, 15, 20, 25, 30, 35];
const yticks = [0, 4, 8, 12, 16];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 320, pad: { l: 44, r: 20, t: 14, b: 44 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 44, r: 12, t: 14, b: 44 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="tangency-cal" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.rf} = <output data-out="rf">3</output></span>
			<input type="range" min="0" max="4.5" step="0.5" value="3" data-param="rf" />
		</label>
		<label>
			<span>{L.w} = <output data-out="w">0.5</output></span>
			<input type="range" min="0" max="1.5" step="0.05" value="0.5" data-param="w" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.cal} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			<defs>
				<clipPath id={`tc-clip-${cls}`}>
					<rect x={pad.l} y={pad.t} width={W - pad.l - pad.r} height={H - pad.t - pad.b} />
				</clipPath>
			</defs>
			{yticks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xticks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<g clip-path={`url(#tc-clip-${cls})`}>
				<polyline class="viz-curve" fill="none" data-el="frontier" points="" />
				<polyline class="viz-avg" fill="none" data-el="cal" points="" />
				<circle class="viz-mean" data-el="rfpt" r="4" cx="0" cy="0" />
				<circle class="viz-min" data-el="pt" r="5" cx="0" cy="0" />
			</g>
			<text class="viz-tick" x={X(20) + 8} y={Y(10) + 14}>A</text>
			<text class="viz-tick" x={X(10) + 8} y={Y(5) + 14}>B</text>
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-curve"></span>{L.frontier}</li>
		<li><span class="sw sw-avg"></span>{L.cal}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initTangencyCal } from '../../scripts/widgets/tangency-cal';
	initTangencyCal();
</script>
