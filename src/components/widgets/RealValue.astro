---
// Figure 1-1 of lesson 6.11: the real value (in today's dollars) of a fixed nominal payment of 1,000 a year over
// 30 years, at an adjustable inflation rate, against an inflation-indexed payment of the same starting size.
// Parameters are registered in course/widgets.yaml (id: real-value). Same model as course/verify/6.11.py.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		pi: '通胀率（%）',
		x: '年',
		y: '按今天物价计的价值',
		fixed: '固定名义金额 1,000',
		indexed: '按通胀调整的支付',
		aria: '固定名义收入的实际价值',
		readout: '固定 1,000 的实际价值：10 年后 {a}，20 年后 {b}，30 年后 {c}。',
	},
	en: {
		pi: 'Inflation rate (%)',
		x: 'Year',
		y: 'Value in today\'s prices',
		fixed: 'Fixed nominal 1,000',
		indexed: 'Inflation-indexed payment',
		aria: 'Real value of a fixed nominal income',
		readout: 'Real value of a fixed 1,000: {a} after 10 years, {b} after 20, {c} after 30.',
	},
}[lang];

const xr = [0, 30];
const yr = [0, 1200];
const xTicks = [0, 10, 20, 30];
const yTicks = [0, 400, 800, 1200];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 52, r: 20, t: 14, b: 48 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 48, r: 12, t: 14, b: 48 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="real-value" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.pi} = <output data-out="pi">3.0</output></span>
			<input type="range" min="0" max="8" step="0.5" value="3" data-param="pi" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			{yTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xTicks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<line class="viz-ols" x1={X(0)} x2={X(30)} y1={Y(1000)} y2={Y(1000)} />
			<path class="viz-fit" fill="none" data-el="fixed" d="" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-fit"></span>{L.fixed}</li>
		<li><span class="sw sw-ols"></span>{L.indexed}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initRealValue } from '../../scripts/widgets/real-value';
	initRealValue();
</script>
