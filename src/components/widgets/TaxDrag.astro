---
// Figure 3-1 of lesson 6.1: after-tax value (if sold that year) of 100 invested at 7% a year in a fund that pays out
// an adjustable share of its value each year as taxable capital gains, against a fund that pays out nothing
// (all tax deferred to the sale). Parameters are registered in course/widgets.yaml (id: tax-drag).
// Same model as course/verify/6.1.py.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		d: '每年分配的资本利得（占净值的 %）',
		t: '资本利得税率（%）',
		x: '年',
		y: '卖出后的税后价值',
		mf: '每年分配资本利得的基金',
		etf: '不分配资本利得的基金',
		aria: '资本利得分配对税后财富的影响',
		readout: '30 年后卖出：不分配的基金税后为 {e}，每年分配的基金为 {m}，少 {g}%。',
	},
	en: {
		d: 'Capital gains paid out each year (% of value)',
		t: 'Capital gains tax rate (%)',
		x: 'Year',
		y: 'After-tax value if sold',
		mf: 'Fund paying out capital gains each year',
		etf: 'Fund paying out no capital gains',
		aria: 'Effect of capital gains distributions on after-tax wealth',
		readout: 'Sold after 30 years: {e} after tax for the fund with no payouts, {m} for the fund paying out each year, {g}% less.',
	},
}[lang];

const xr = [0, 30];
const yr = [0, 700];
const xTicks = [0, 10, 20, 30];
const yTicks = [0, 200, 400, 600];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 48, r: 20, t: 14, b: 48 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 44, r: 12, t: 14, b: 48 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="tax-drag" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.d} = <output data-out="d">4</output></span>
			<input type="range" min="0" max="8" step="1" value="4" data-param="d" />
		</label>
		<label>
			<span>{L.t} = <output data-out="t">15</output></span>
			<input type="range" min="0" max="25" step="5" value="15" data-param="t" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			{yTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xTicks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<path class="viz-ols" fill="none" data-el="etf" d="" />
			<path class="viz-fit" fill="none" data-el="mf" d="" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-ols"></span>{L.etf}</li>
		<li><span class="sw sw-fit"></span>{L.mf}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initTaxDrag } from '../../scripts/widgets/tax-drag';
	initTaxDrag();
</script>
