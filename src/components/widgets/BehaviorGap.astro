---
// Figure 3-1 of lesson 6.10: the behavior gap. A fund returns +20%, +25%, +15%, -30%, -10%, +25%, +20%, +10% over
// 8 years. The investor puts in 100 at the start and, at the start of each later year, adds 20 plus an amount that
// follows the previous year's return (chasing intensity k: 100 k times last year's return; negative means selling).
// Bars: the fund's time-weighted return and the investor's dollar-weighted return (IRR of the cash flows).
// Parameters are registered in course/widgets.yaml (id: behavior-gap). Same model as course/verify/6.10.py.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		k: '追涨杀跌的程度 k',
		rows: ['基金', '投资者'],
		aria: '时间加权收益与资金加权收益',
		readout: '基金（时间加权）每年 {t}%，投资者（资金加权）每年 {d}%，相差 {g} 个百分点。',
	},
	en: {
		k: 'Return chasing k',
		rows: ['Fund', 'Investor'],
		aria: 'Time-weighted and dollar-weighted returns',
		readout: 'Fund (time-weighted) {t}% a year, investor (dollar-weighted) {d}% a year, a gap of {g} percentage points.',
	},
}[lang];

const xr = [0, 10];
const xTicks = [0, 2, 4, 6, 8, 10];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 160, pad: { l: 90, r: 24, t: 14, b: 40 } },
	{ cls: 'viz-narrow', W: 360, H: 160, pad: { l: 70, r: 14, t: 14, b: 40 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	rowY: (i: number) => g.pad.t + 8 + i * ((g.H - g.pad.t - g.pad.b) / 2),
	barH: (g.H - g.pad.t - g.pad.b) / 2 - 16,
}));
---

<div class="lfwai-widget" data-widget="behavior-gap" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.k} = <output data-out="k">1.0</output></span>
			<input type="range" min="0" max="2" step="0.5" value="1" data-param="k" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, rowY, barH }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, pad, xr })}>
			{xTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={X(v)} x2={X(v)} y1={pad.t} y2={H - pad.b} />
					<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}%</text>
				</g>
			))}
			{L.rows.map((name, i) => (
				<g>
					<text class="viz-tick" x={pad.l - 8} y={rowY(i) + barH / 2 + 4} text-anchor="end">{name}</text>
					<rect class={i === 0 ? 'viz-bar-total' : 'viz-bar'} data-bar={i} x={X(0)} y={rowY(i)} width="0" height={barH} />
				</g>
			))}
		</svg>
	))}
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<style>
	.viz-bar {
		fill: var(--sl-color-accent);
	}
	.viz-bar-total {
		fill: var(--sl-color-gray-3);
	}
</style>

<script>
	import { initBehaviorGap } from '../../scripts/widgets/behavior-gap';
	initBehaviorGap();
</script>
