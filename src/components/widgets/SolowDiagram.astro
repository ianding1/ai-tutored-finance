---
// Figure 4-1 of lesson 2.2: the Solow diagram with y = k^(1/3) per worker, depreciation plus labor growth
// δ + n = 0.06. The slider sets the saving rate s; the curve is investment per worker s·y, the line is
// break-even investment (δ + n)·k, and the point is the steady state k* = (s / 0.06)^(3/2).
// Parameters are registered in course/widgets.yaml (id: solow).
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		s: '储蓄率 s',
		x: '人均资本 k',
		y: '人均数量',
		inv: '人均投资 s·y',
		dep: '维持人均资本所需的投资 (δ + n)·k',
		ss: '稳态',
		readout: '稳态人均资本 k* = {k}，人均产出 y* = {y}，人均消费 c* = {c}。',
	},
	en: {
		s: 'Saving rate s',
		x: 'Capital per worker k',
		y: 'Amount per worker',
		inv: 'Investment per worker s·y',
		dep: 'Investment needed to keep capital per worker (δ + n)·k',
		ss: 'Steady state',
		readout: 'Steady-state capital per worker k* = {k}, output per worker y* = {y}, consumption per worker c* = {c}.',
	},
}[lang];

const xr = [0, 30];
const yr = [0, 2];
const xticks = [0, 5, 10, 15, 20, 25, 30];
const yticks = [0, 0.5, 1, 1.5, 2];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 320, pad: { l: 50, r: 20, t: 14, b: 44 } },
	{ cls: 'viz-narrow', W: 360, H: 290, pad: { l: 50, r: 12, t: 14, b: 44 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="solow" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.s} = <output data-out="s">0.20</output></span>
			<input type="range" min="0.1" max="0.5" step="0.05" value="0.2" data-param="s" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.ss} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			{yticks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xticks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<line class="viz-curve-fat" x1={X(0)} y1={Y(0)} x2={X(30)} y2={Y(1.8)} />
			<polyline class="viz-curve" data-el="inv" points="" />
			<line class="viz-mean" data-el="vk" x1="0" y1="0" x2="0" y2="0" />
			<circle class="viz-min" data-el="pt" r="6" cx="0" cy="0" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-curve"></span>{L.inv}</li>
		<li><span class="sw sw-fat"></span>{L.dep}</li>
		<li><span class="sw sw-min"></span>{L.ss}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initSolow } from '../../scripts/widgets/solow';
	initSolow();
</script>
