---
// Figure 3-1 of lesson 6.3: probability that an active fund with no skill before costs beats its index over
// T years, P = N(-f sqrt(T) / s), for an adjustable yearly cost f and tracking error s (normal yearly gaps).
// Parameters are registered in course/widgets.yaml (id: beat-prob). Same model as course/verify/6.3.py.
import { toLang } from '../../i18n/ui';

const lang = toLang(Astro.locals.starlightRoute.lang);
const L = {
	'zh-cn': {
		f: '每年的成本（%）',
		s: '跟踪误差（%）',
		x: '年数',
		y: '跑赢指数的概率（%）',
		line: '没有能力的基金在这段时间内累计跑赢指数的概率',
		aria: '没有能力的主动基金跑赢指数的概率',
		readout: '1 年 {p1}%，10 年 {p10}%，20 年 {p20}%。',
	},
	en: {
		f: 'Yearly cost (%)',
		s: 'Tracking error (%)',
		x: 'Years',
		y: 'Probability of beating the index (%)',
		line: 'Probability that a fund with no skill beats the index over the period',
		aria: 'Probability that an active fund with no skill beats its index',
		readout: '1 year {p1}%, 10 years {p10}%, 20 years {p20}%.',
	},
}[lang];

const xr = [0, 30];
const yr = [0, 50];
const xTicks = [0, 10, 20, 30];
const yTicks = [0, 10, 20, 30, 40, 50];
const layouts = [
	{ cls: 'viz-wide', W: 640, H: 300, pad: { l: 44, r: 20, t: 14, b: 48 } },
	{ cls: 'viz-narrow', W: 360, H: 300, pad: { l: 40, r: 12, t: 14, b: 48 } },
].map((g) => ({
	...g,
	X: (v: number) => g.pad.l + ((v - xr[0]) / (xr[1] - xr[0])) * (g.W - g.pad.l - g.pad.r),
	Y: (v: number) => g.pad.t + ((yr[1] - v) / (yr[1] - yr[0])) * (g.H - g.pad.t - g.pad.b),
}));
---

<div class="lfwai-widget" data-widget="beat-prob" data-readout={L.readout}>
	<div class="lfwai-sliders">
		<label>
			<span>{L.f} = <output data-out="f">1.00</output></span>
			<input type="range" min="0" max="2" step="0.25" value="1" data-param="f" />
		</label>
		<label>
			<span>{L.s} = <output data-out="s">5</output></span>
			<input type="range" min="2" max="10" step="1" value="5" data-param="s" />
		</label>
	</div>
	{layouts.map(({ cls, W, H, pad, X, Y }) => (
		<svg class={`lfwai-viz ${cls}`} viewBox={`0 0 ${W} ${H}`} role="img" aria-label={L.aria} data-geom={JSON.stringify({ W, H, pad, xr, yr })}>
			{yTicks.map((v) => (
				<g>
					<line class={v === 0 ? 'viz-axis' : 'viz-grid'} x1={pad.l} x2={W - pad.r} y1={Y(v)} y2={Y(v)} />
					<text class="viz-tick" x={pad.l - 8} y={Y(v) + 4} text-anchor="end">{v}</text>
				</g>
			))}
			{xTicks.map((v) => (
				<text class="viz-tick" x={X(v)} y={H - pad.b + 18} text-anchor="middle">{v}</text>
			))}
			<line class="viz-axis" x1={pad.l} x2={pad.l} y1={pad.t} y2={H - pad.b} />
			<text class="viz-tick" x={(pad.l + W - pad.r) / 2} y={H - 8} text-anchor="middle">{L.x}</text>
			<text class="viz-tick" transform={`translate(12 ${(pad.t + H - pad.b) / 2}) rotate(-90)`} text-anchor="middle">{L.y}</text>
			<path class="viz-fit" fill="none" data-el="prob" d="" />
		</svg>
	))}
	<ul class="lfwai-legend">
		<li><span class="sw sw-fit"></span>{L.line}</li>
	</ul>
	<p class="lfwai-readout" data-el="readout" aria-live="polite"></p>
</div>

<script>
	import { initBeatProb } from '../../scripts/widgets/beat-prob';
	initBeatProb();
</script>
