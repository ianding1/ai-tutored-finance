---
// <Judgments /> — the key judgments of a capstone step. The learner writes a judgment record for
// each and discusses them with the AI using one discussion prompt; each judgment is marked ok or revise.
import { toLang } from '../i18n/ui';
import { lessonKey } from '../lib/course';
import { gradingPayload, questionLabel } from '../lib/grading';
import QuestionBody from './QuestionBody.astro';
import GradeControls from './GradeControls.astro';

const route = Astro.locals.starlightRoute;
const lang = toLang(route.lang);
const lessonId = route.entry.data.lesson;
if (!lessonId) throw new Error('<Judgments> can only be used on a lesson page (frontmatter "lesson")');
const qs = (lessonKey(lessonId)?.questions ?? []).filter((q) => q.kind === 'judgment');
---

<section class="lfwai-group lfwai-exercises not-content" data-lfwai-group>
	{qs.map((q) => <QuestionBody q={q} lang={lang} lessonId={lessonId} label={questionLabel(q, lang)} />)}
	<GradeControls lang={lang} payload={gradingPayload(lessonId, qs, lang)} mode="discussion" />
</section>
